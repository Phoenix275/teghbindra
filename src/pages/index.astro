---
import '../styles/global.css';
import { contact, ledger, projects, writing, experience, education, leadership } from '../data/site';

const description =
  'Tegh S. Bindra — builder and researcher from Sugar Land, TX. Shipped an AI underwriting workbench, published at MIT URTC, Codeforces Master (2150).';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Tegh S. Bindra',
  email: `mailto:${contact.email}`,
  url: 'https://teghbindra.com',
  jobTitle: 'Student, builder & researcher',
  address: { '@type': 'PostalAddress', addressLocality: 'Sugar Land', addressRegion: 'TX' },
  alumniOf: 'William P. Clements High School',
  sameAs: [contact.github, contact.linkedin],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tegh S. Bindra</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://teghbindra.com/" />
    <meta property="og:title" content="Tegh S. Bindra" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://teghbindra.com/" />
    <meta property="og:image" content="https://teghbindra.com/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=STIX+Two+Text:ital,wght@0,400;0,600;1,400&family=Public+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <div class="wrap">
      <header class="top">
        <a class="site" href="/">TEGHBINDRA.COM</a>
        <nav>
          <a href="#work">Work</a>
          <a href="#writing">Writing</a>
          <a href="#experience">Experience</a>
          <a href="#leadership">Leadership</a>
          <a href="#contact">Contact</a>
          <a href={contact.resume}>Résumé ↓</a>
        </nav>
      </header>

      <div class="hero">
        <div>
          <p class="eyebrow">Case file — Sugar Land, TX</p>
          <h1>I build systems that turn messy data into decisions.</h1>
          <p class="intro">
            I'm Tegh — I've shipped a <strong>live AI underwriting workbench</strong> for a
            Tech Mahindra internship, published <strong>clinical-NLP research at MIT URTC</strong>,
            and co-authored a <strong>reward-debiasing system</strong> that cut model scoring bias
            by ~12%. Currently: economics at UT San Antonio → UT Austin (CAP), Class of 2030.
          </p>
          <p class="where">
            <span>{contact.location}</span><span class="dot">·</span>
            <a href={`mailto:${contact.email}`}>{contact.email}</a><span class="dot">·</span>
            <a href={contact.github}>GitHub</a><span class="dot">·</span>
            <a href={contact.linkedin}>LinkedIn</a>
          </p>
        </div>

        <div>
          <div class="ledger" aria-label="Case summary">
            <div class="ledger-head">
              <span>Case summary</span>
              <span class="ref">REF TSB-2030</span>
            </div>
            <ul class="ledger-rows">
              {ledger.map((row) => (
                <li>
                  <span class="k">{row.label}</span>
                  <span class="leader" aria-hidden="true"></span>
                  <span class="v">
                    {row.href ? <a href={row.href}>{row.value}</a> : row.value}
                    <small>{row.note}</small>
                  </span>
                </li>
              ))}
            </ul>
            <div class="verdict">
              <span class="k">Status</span>
              <span class="leader" aria-hidden="true"></span>
              <span class="v"><span class="lamp" aria-hidden="true"></span>OPEN TO INTERNSHIPS</span>
            </div>
          </div>
          <p class="ledger-note">
            Card format borrowed from my underwriting engine's decision output.
          </p>
        </div>
      </div>

      <section id="work">
        <div class="section-grid">
          <div class="section-label">Selected work</div>
          <div>
            {projects.map((p) => (
              <article class="project" id={p.slug}>
                <div class="project-head">
                  <h3>{p.name}</h3>
                  <span class="year">{p.year}</span>
                </div>
                <p class="role">{p.role}</p>
                <div class="pbr">
                  <p><b>Problem</b> {p.problem}</p>
                  <p><b>Built</b> {p.built}</p>
                  <div class="result"><p><b>Result</b> {p.outcome}</p></div>
                </div>
                <div class="project-foot">
                  <span class="stack">{p.stack.join(' · ')}</span>
                  {p.links.map((l) => (
                    <a href={l.href}>{l.label} →</a>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="writing">
        <div class="section-grid">
          <div class="section-label">Writing</div>
          <ul class="writing-list">
            {writing.map((w) => (
              <li>
                <div class="row">
                  <a class="title" href={w.href}>{w.title}</a>
                  <span class="leader" aria-hidden="true"></span>
                  <span class="date">{w.date}</span>
                </div>
                <p class="blurb">{w.blurb}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="experience">
        <div class="section-grid">
          <div class="section-label">Experience</div>
          <ul class="xp">
            {experience.map((x) => (
              <li>
                <div class="row">
                  <span class="org">{x.org}</span>
                  <span class="leader" aria-hidden="true"></span>
                  <span class="period">{x.period}</span>
                </div>
                <p class="role">{x.role}</p>
                <p class="line">{x.line}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="education">
        <div class="section-grid">
          <div class="section-label">Education</div>
          <ul class="xp">
            {education.map((e) => (
              <li>
                <div class="row"><span class="org">{e.school}</span></div>
                <p class="line">{e.detail}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="leadership">
        <div class="section-grid">
          <div class="section-label">Leadership &amp; honors</div>
          <div class="honors">
            {leadership.map((h) => (
              <div>
                <p class="what">{h.what}</p>
                <p class="detail">{h.detail}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <footer id="contact">
        <h2>Let's talk.</h2>
        <p class="pitch">
          I'm looking for internships and research collaborations where shipping fast and
          measuring honestly both matter. The quickest way to reach me is email — I reply.
        </p>
        <div class="contact-row">
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          <a href={contact.github}>github.com/Phoenix275</a>
          <a href={contact.linkedin}>LinkedIn</a>
          <a href={contact.resume}>Résumé (PDF) ↓</a>
        </div>
        <div class="colophon">
          <span>© {new Date().getFullYear()} Tegh S. Bindra — hand-built with Astro, no template.</span>
          <span class="lights" title="approve · refer · decline"><i class="g"></i><i class="a"></i><i class="r"></i></span>
        </div>
      </footer>
    </div>
  </body>
</html>
